<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="App.CMS.Views.CourseDetailPage"
             Title="Course Details"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20">

            <!-- Course Header Card with Top-Right Grade Display -->
            <Border BackgroundColor="#0F172A" StrokeShape="RoundRectangle 12" Padding="20">
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="15">
                    
                    <!-- Course info on the left side-->
                    <VerticalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                        <Label x:Name="CourseNameLabel" FontSize="22" FontAttributes="Bold" TextColor="White" />
                        <Label x:Name="CourseCodeLabel" FontSize="14" TextColor="#94A3B8" />
                        <Label x:Name="CourseDescriptionLabel" FontSize="14" TextColor="#CBD5E1" Margin="0,5,0,0" />
                    </VerticalStackLayout>

                    <!-- top right grade badge-->
                    <Border Grid.Column="1" 
                            x:Name="GradeBadgeBorder"
                            BackgroundColor="#1E293B" 
                            Stroke="#3B82F6" 
                            StrokeThickness="2" 
                            StrokeShape="RoundRectangle 10" 
                            Padding="12,8" 
                            VerticalOptions="Start" 
                            HorizontalOptions="End">
                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                            <Label Text="CURRENT GRADE" 
                                   FontSize="10" 
                                   FontAttributes="Bold" 
                                   TextColor="#94A3B8" 
                                   HorizontalOptions="Center" />
                            
                            <!--letter grade (A for now) -->
                            <Label x:Name="LetterGradeLabel" 
                                   FontSize="26" 
                                   FontAttributes="Bold" 
                                   TextColor="#22C55E" 
                                   HorizontalOptions="Center" />
                            
                            <!--num grade in percentage (default for now) -->
                            <Label x:Name="NumericGradeLabel" 
                                   FontSize="13" 
                                   FontAttributes="Bold" 
                                   TextColor="#F8FAFC" 
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>

                </Grid>
            </Border>

            <!-- Announcements section at the top-->
            <Border x:Name="StudentAnnouncementsCard" 
                    IsVisible="False" 
                    BackgroundColor="#EFF6FF" 
                    Stroke="#93C5FD" 
                    StrokeShape="RoundRectangle 10" 
                    Padding="15" 
                    Margin="0,0,0,10">
                <VerticalStackLayout Spacing="10">
                    <Label Text="📢 Course Announcements" 
                        FontSize="16" 
                        FontAttributes="Bold" 
                        TextColor="#1E40AF" />

                    <CollectionView x:Name="StudentAnnouncementsCollectionView" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeShape="RoundRectangle 6" 
                                        Padding="12" 
                                        Margin="0,0,0,8" 
                                        BackgroundColor="White" 
                                        Stroke="#BFDBFE">
                                    <VerticalStackLayout Spacing="4">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <Label Grid.Column="0" 
                                                Text="{Binding Title}" 
                                                FontSize="15" 
                                                FontAttributes="Bold" 
                                                TextColor="#1E3A8A" />
                                            
                                            <Label Grid.Column="1" 
                                                Text="{Binding DatePosted, StringFormat='{0:MMM dd}'}" 
                                                FontSize="12" 
                                                TextColor="#6B7280" />
                                        </Grid>
                                        
                                        <Label Text="{Binding Content}" 
                                            FontSize="13" 
                                            TextColor="#374151" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- Interaction Sections -->
            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="10">
                <Button x:Name="BtnAssignments" Grid.Column="0" Text="Assignments" BackgroundColor="#2563EB" TextColor="White" CornerRadius="8" Clicked="OnAssignmentsTabClicked" />
                <Button x:Name="BtnModules" Grid.Column="1" Text="Modules" BackgroundColor="#475569" TextColor="White" CornerRadius="8" Clicked="OnModulesTabClicked" />
                <Button x:Name="BtnGrades" Grid.Column="2" Text="Grades" BackgroundColor="#475569" TextColor="White" CornerRadius="8" Clicked="OnGradesTabClicked" />
            </Grid>

            <!--1: Assignments List -->
            <VerticalStackLayout x:Name="AssignmentsSection" Spacing="15" IsVisible="True">
                <Label Text="Course Assignments" FontSize="18" FontAttributes="Bold" TextColor="#1E293B" />

                <CollectionView x:Name="AssignmentsListView" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame BorderColor="#E2E8F0" CornerRadius="10" Padding="15" Margin="0,0,0,12" BackgroundColor="White">
                                <VerticalStackLayout Spacing="10">
                                    
                                    <!-- Assignment Header Info -->
                                    <Grid ColumnDefinitions="*, Auto">
                                        <VerticalStackLayout Grid.Column="0">
                                            <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" />
                                            <Label Text="{Binding Description}" FontSize="13" TextColor="#64748B" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding TotalAvailablePoints, StringFormat='{0} pts'}" FontSize="14" FontAttributes="Bold" TextColor="#2563EB" VerticalOptions="Center" />
                                    </Grid>

                                    <!-- Submit Button to toggle response box -->
                                    <Button Text="Submit Assignment" 
                                            BackgroundColor="#2563EB" 
                                            TextColor="White" 
                                            CornerRadius="6" 
                                            HeightRequest="38"
                                            HorizontalOptions="Start"
                                            Clicked="OnOpenSubmissionFormClicked"
                                            CommandParameter="{Binding .}" />

                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Submission Card/Shown when assignment is selected -->
                <Frame x:Name="SubmissionCard" 
                    BorderColor="#2563EB" 
                    CornerRadius="10" 
                    Padding="15" 
                    BackgroundColor="#F0F6FF" 
                    IsVisible="False">
                    <VerticalStackLayout Spacing="12">
                        <Label x:Name="SelectedAssignmentLabel" 
                            FontSize="16" 
                            FontAttributes="Bold" 
                            TextColor="#1E3A8A" />

                        <Label Text="Your Response:" 
                            FontSize="14" 
                            TextColor="#334155" />

                        <!-- Multiline Textbox for Response -->
                        <Editor x:Name="StudentResponseEditor" 
                                Placeholder="Enter your assignment response here..." 
                                HeightRequest="120" 
                                BackgroundColor="White" 
                                TextColor="#0F172A" 
                                FontSize="14" />
                        <!-- File Picker Row -->
                        <Button Text="📎 Attach File" 
                                Clicked="OnAttachFileClicked" 
                                BackgroundColor="#E2E8F0" 
                                TextColor="#0F172A" />

                        <!-- file picker label-->
                        <Label x:Name="SelectedFileLabel" 
                            FontSize="13" 
                            TextColor="#0284C7" 
                            FontAttributes="Bold" 
                            IsVisible="False" />

                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                            <Button Grid.Column="0" 
                                    Text="Submit Response" 
                                    BackgroundColor="#16A34A" 
                                    TextColor="White" 
                                    CornerRadius="6" 
                                    Clicked="OnSubmitAssignmentClicked" />

                            <Button Grid.Column="1" 
                                    Text="Cancel" 
                                    BackgroundColor="#94A3B8" 
                                    TextColor="White" 
                                    CornerRadius="6" 
                                    Clicked="OnCancelSubmissionClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
            <!-- 2: Modules section -->
            <VerticalStackLayout x:Name="ModulesSection" Spacing="15" IsVisible="False">
                <Label Text="Course Modules &amp; Materials" FontSize="18" FontAttributes="Bold" TextColor="#1E293B" />

                <CollectionView x:Name="ModulesListView" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeShape="RoundRectangle 10" Padding="15" Margin="0,0,0,12" BackgroundColor="White" Stroke="#CBD5E1">
                                <VerticalStackLayout Spacing="10">

                                    <!-- header -->
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" />
                                        <Label Text="{Binding Description}" FontSize="13" TextColor="#475569" />
                                    </VerticalStackLayout>

                                    <!--Module content list-->
                                    <Border BackgroundColor="#F8FAFC" Padding="10" StrokeShape="RoundRectangle 8" Stroke="#E2E8F0">
                                        <VerticalStackLayout Spacing="8">
                                            <Label Text="Module Materials:" FontSize="12" FontAttributes="Bold" TextColor="#64748B" />

                                            <CollectionView ItemsSource="{Binding Content}" SelectionMode="None">
                                                <CollectionView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border StrokeShape="RoundRectangle 6" Padding="10" Margin="0,2,0,6" BackgroundColor="White" Stroke="#E2E8F0">
                                                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                                                                
                                                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                                    <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" TextColor="#0F172A" />

                                                                    <!--preview page body -->
                                                                    <Label Text="{Binding Body, StringFormat='📄 {0}'}" 
                                                                        FontSize="12" 
                                                                        TextColor="#475569" 
                                                                        MaxLines="2" 
                                                                        LineBreakMode="TailTruncation" />

                                                                    <!--preview file path-->
                                                                    <Label Text="{Binding FilePath, StringFormat='📁 Path: {0}'}" 
                                                                        FontSize="12" 
                                                                        TextColor="#2563EB" 
                                                                        MaxLines="1" 
                                                                        LineBreakMode="MiddleTruncation" />
                                                                </VerticalStackLayout>

                                                                <!--Student action button-->
                                                                <Button Grid.Column="1" 
                                                                        Text="Open Material" 
                                                                        BackgroundColor="#0F172A" 
                                                                        TextColor="White" 
                                                                        CornerRadius="6" 
                                                                        HeightRequest="32" 
                                                                        FontSize="12"
                                                                        VerticalOptions="Center" 
                                                                        Clicked="OnOpenModuleContentClicked" 
                                                                        CommandParameter="{Binding .}" />

                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </CollectionView.ItemTemplate>
                                            </CollectionView>
                                        </VerticalStackLayout>
                                    </Border>

                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- Grades Section -->
            <VerticalStackLayout x:Name="GradesSection" Spacing="15" IsVisible="False">
                
                <!-- course grade section header-->
                <Border StrokeShape="RoundRectangle 10" Padding="15" BackgroundColor="#F0F9FF" Stroke="#BAE6FD">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Your Course Grade" FontSize="18" FontAttributes="Bold" TextColor="#0369A1" />
                        <Label x:Name="OverallGradeLabel" FontSize="22" FontAttributes="Bold" TextColor="#0284C7" Text="Calculating..." />
                        <Label x:Name="GradingScaleBreakdownLabel" FontSize="12" TextColor="#0369A1" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="Assignment Gradebook" FontSize="16" FontAttributes="Bold" TextColor="#1E293B" Margin="0,5,0,0" />

                <!--gradebook table header -->
                <Border StrokeShape="RoundRectangle 6" Padding="10" BackgroundColor="#E2E8F0" Stroke="Transparent">
                    <Grid ColumnDefinitions="*, 80, 80, 80">
                        <Label Grid.Column="0" Text="Assignment" FontAttributes="Bold" FontSize="13" TextColor="#334155" />
                        <Label Grid.Column="1" Text="Score" FontAttributes="Bold" FontSize="13" TextColor="#334155" HorizontalOptions="Center" />
                        <Label Grid.Column="2" Text="Pct (%)" FontAttributes="Bold" FontSize="13" TextColor="#334155" HorizontalOptions="Center" />
                        <Label Grid.Column="3" Text="Grade" FontAttributes="Bold" FontSize="13" TextColor="#334155" HorizontalOptions="Center" />
                    </Grid>
                </Border>

                <!--dynamic gradebook container -->
                <VerticalStackLayout x:Name="StudentGradebookRowsContainer" Spacing="6" />

            </VerticalStackLayout>

            <!-- navigation back button -->
            <Button Text="⬅️ Back to Student Portal" BackgroundColor="#64748B" TextColor="White" CornerRadius="8" HeightRequest="45" Margin="0,15,0,0" Clicked="OnBackClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>