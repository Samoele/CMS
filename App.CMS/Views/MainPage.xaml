<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="App.CMS.Views.MainPage"
             Title="Course Management System"
             BackgroundColor="#F4F6F8">

    <ScrollView>
        <VerticalStackLayout Spacing="20"
                             Padding="40"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             MaximumWidthRequest="450">

            <!--title header-->
            <Label Text="Welcome to CMS"
                   FontSize="30"
                   FontAttributes="Bold"
                   TextColor="#1E293B"
                   HorizontalOptions="Center" />

            <Label Text="Please select your portal to continue:"
                   FontSize="16"
                   TextColor="#64748B"
                   HorizontalOptions="Center"
                   Margin="0,0,0,20" />

            <!--Portal selection buttons-->
            <Button x:Name="TeacherButton"
                    Text="👨‍🏫  Teacher Portal"
                    FontSize="18"
                    FontAttributes="Bold"
                    BackgroundColor="#0F172A"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="55"
                    Clicked="OnTeacherButtonClicked" />

            <Button x:Name="StudentButton"
                    Text="🎓  Student Portal"
                    FontSize="18"
                    FontAttributes="Bold"
                    BackgroundColor="#2563EB"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="55"
                    Clicked="OnStudentButtonClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>