<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="App.CMS.Views.TeacherCourseDetailPage"
             Title="Manage Course"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20">

            <!--course header banner -->
            <Border BackgroundColor="#0F172A" StrokeShape="RoundRectangle 12" Padding="20">
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="CourseNameLabel" FontSize="22" FontAttributes="Bold" TextColor="White" />
                    <Label x:Name="CourseCodeLabel" FontSize="14" TextColor="#94A3B8" />
                    <Label x:Name="CourseDescriptionLabel" FontSize="14" TextColor="#CBD5E1" Margin="0,5,0,0" />
                </VerticalStackLayout>
            </Border>

            <!--navigation tabs -->
            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="10">
                <Button x:Name="BtnRoster" Grid.Column="0" Text="Roster" BackgroundColor="#0F172A" TextColor="White" CornerRadius="8" Clicked="OnRosterTabClicked" />
                <Button x:Name="BtnAssignments" Grid.Column="1" Text="Assignments" BackgroundColor="#475569" TextColor="White" CornerRadius="8" Clicked="OnAssignmentsTabClicked" />
                <Button x:Name="BtnModules" Grid.Column="2" Text="Modules" BackgroundColor="#475569" TextColor="White" CornerRadius="8" Clicked="OnModulesTabClicked" />
            </Grid>

            <!--SECTION 1: ROSTER MANAGEMENT -->
            <VerticalStackLayout x:Name="RosterSection" Spacing="15" IsVisible="True">
                <Label Text="Course Roster Management" FontSize="18" FontAttributes="Bold" TextColor="#1E293B" />

                <!-- Current Roster List -->
                <Label Text="Currently Enrolled Students:" FontSize="14" FontAttributes="Bold" TextColor="#475569" />
                <CollectionView x:Name="RosterCollectionView" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeShape="RoundRectangle 8" Padding="12" Margin="0,0,0,8" BackgroundColor="White" Stroke="#E2E8F0">
                                <Grid ColumnDefinitions="*, Auto">
                                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" />
                                        <Label Text="{Binding Id, StringFormat='Student ID: {0}'}" FontSize="12" TextColor="#64748B" />
                                    </VerticalStackLayout>
                                    
                                    <Button Grid.Column="1" 
                                            Text="Remove" 
                                            BackgroundColor="#EF4444" 
                                            TextColor="White" 
                                            CornerRadius="6" 
                                            HeightRequest="36"
                                            Clicked="OnRemoveStudentClicked" 
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Enroll Student Section -->
                <Border StrokeShape="RoundRectangle 10" Padding="15" BackgroundColor="#F1F5F9" Stroke="#CBD5E1">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Enroll a Student:" FontSize="14" FontAttributes="Bold" TextColor="#334155" />
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                            <Picker x:Name="AvailableStudentsPicker" 
                                    Grid.Column="0" 
                                    Title="Select student..." 
                                    ItemDisplayBinding="{Binding Name}" 
                                    BackgroundColor="White" />
                            
                            <Button Grid.Column="1" 
                                    Text="Enroll Student" 
                                    BackgroundColor="#16A34A" 
                                    TextColor="White" 
                                    CornerRadius="6" 
                                    Clicked="OnEnrollStudentClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!--SECTION 2: ASSIGNMENTS MANAGEMENT (Placeholder for next step) -->
            <VerticalStackLayout x:Name="AssignmentsSection" Spacing="10" IsVisible="False">
                <Label Text="Course Assignments Management" FontSize="18" FontAttributes="Bold" TextColor="#1E293B" />
                <Label Text="Instructor assignment creation and editing tools will go here." TextColor="#64748B" />
            </VerticalStackLayout>

            <!--SECTION 3: MODULES MANAGEMENT (Placeholder for next step) -->
            <VerticalStackLayout x:Name="ModulesSection" Spacing="10" IsVisible="False">
                <Label Text="Course Modules Management" FontSize="18" FontAttributes="Bold" TextColor="#1E293B" />
                <Label Text="Instructor module and content editing tools will go here." TextColor="#64748B" />
            </VerticalStackLayout>

            <!-- Go Back Button -->
            <Button Text="⬅️ Back to Instructor Dashboard" 
                    BackgroundColor="#64748B" 
                    TextColor="White" 
                    CornerRadius="8" 
                    HeightRequest="45" 
                    Margin="0,15,0,0" 
                    Clicked="OnBackClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>