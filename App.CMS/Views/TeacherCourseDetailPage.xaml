<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="App.CMS.Views.TeacherCourseDetailPage"
             Title="Manage Course"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20">

            <!--course header banner -->
            <Border BackgroundColor="#0F172A" StrokeShape="RoundRectangle 12" Padding="20">
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="CourseNameLabel" FontSize="22" FontAttributes="Bold" TextColor="White" />
                    <Label x:Name="CourseCodeLabel" FontSize="14" TextColor="#94A3B8" />
                    <Label x:Name="CourseDescriptionLabel" FontSize="14" TextColor="#CBD5E1" Margin="0,5,0,0" />
                </VerticalStackLayout>
            </Border>
            <!--COURSE SETTINGS BUTTON(Letter ranges/grade percentage and future options) -->
            <Button Grid.Column="1" 
                    Text="⚙️ Settings" 
                    BackgroundColor="#334155" 
                    TextColor="White" 
                    FontAttributes="Bold"
                    CornerRadius="8" 
                    HeightRequest="38" 
                    Clicked="OnCourseSettingsClicked" />
            <!-- SETTINGS SECTION: COURSE SETTINGS AND CONFIGURATION/Not visible unless clicked-->
            <VerticalStackLayout x:Name="SettingsSection" Spacing="15" IsVisible="False">
                
                <Label Text="⚙️ Course Settings" FontSize="20" FontAttributes="Bold" TextColor="#0F172A" />
                <!-- close settings button-->
                <Button Grid.Column="1"  
                        Text="✖ Close Settings" 
                        BackgroundColor="#EF4444" 
                        TextColor="White" 
                        FontAttributes="Bold" 
                        CornerRadius="6" 
                        HeightRequest="36" 
                        Clicked="OnCloseSettingsClicked" />

                <!--Option1: Letter grade scale-->
                <Border BackgroundColor="#F8FAFC" Stroke="#CBD5E1" StrokeShape="RoundRectangle 10" Padding="15">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Letter Grade Ranges" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" />
                        <Label Text="Set the minimum percentage required for each letter grade (e.g A = 90)" FontSize="12" TextColor="#64748B" />

                        <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto, Auto, Auto" RowSpacing="8" ColumnSpacing="10">
                            <Label Grid.Row="0" Grid.Column="0" Text="Minimum % for A:" VerticalOptions="Center" FontAttributes="Bold" />
                            <Entry Grid.Row="0" Grid.Column="1" x:Name="EntryGradeA" Keyboard="Numeric" Placeholder="90" BackgroundColor="White" />

                            <Label Grid.Row="1" Grid.Column="0" Text="Minimum % for B:" VerticalOptions="Center" FontAttributes="Bold" />
                            <Entry Grid.Row="1" Grid.Column="1" x:Name="EntryGradeB" Keyboard="Numeric" Placeholder="80" BackgroundColor="White" />

                            <Label Grid.Row="2" Grid.Column="0" Text="Minimum % for C:" VerticalOptions="Center" FontAttributes="Bold" />
                            <Entry Grid.Row="2" Grid.Column="1" x:Name="EntryGradeC" Keyboard="Numeric" Placeholder="70" BackgroundColor="White" />

                            <Label Grid.Row="3" Grid.Column="0" Text="Minimum % for D:" VerticalOptions="Center" FontAttributes="Bold" />
                            <Entry Grid.Row="3" Grid.Column="1" x:Name="EntryGradeD" Keyboard="Numeric" Placeholder="60" BackgroundColor="White" />
                        </Grid>

                        <Button Text="Save Grade Ranges" 
                                BackgroundColor="#0D9488" 
                                TextColor="White" 
                                FontAttributes="Bold" 
                                CornerRadius="6" 
                                HeightRequest="40" 
                                Clicked="OnSaveGradeScaleClicked" />
                    </VerticalStackLayout>
                </Border>

                <!--Option2: Set assignment weighs -->
                <Border BackgroundColor="#F8FAFC" Stroke="#CBD5E1" StrokeShape="RoundRectangle 10" Padding="15">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Assignment Weight Percentage" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" />
                        <Label Text="Configure the weighted percentage contribution for each course assignment." FontSize="12" TextColor="#64748B" />

                        <CollectionView x:Name="WeightsCollectionView" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*, 120" ColumnSpacing="10" Margin="0,0,0,8">
                                        <Label Grid.Column="0" Text="{Binding Name}" VerticalOptions="Center" FontAttributes="Bold" TextColor="#334155" />
                                        <Entry Grid.Column="1" Text="{Binding Weight, Mode=TwoWay}" Keyboard="Numeric" Placeholder="Weight %" BackgroundColor="White" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Button Text="Save Assignment Weight Percentages" 
                                BackgroundColor="#6366F1" 
                                TextColor="White" 
                                FontAttributes="Bold" 
                                CornerRadius="6" 
                                HeightRequest="40" 
                                Clicked="OnSaveWeightsClicked" />
                    </VerticalStackLayout>
                </Border>

                <!--Option3: Course Details(Course editing)-->
                <Border BackgroundColor="#F8FAFC" Stroke="#CBD5E1" StrokeShape="RoundRectangle 10" Padding="15">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Basic Course Info" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" />
                        
                        <Entry x:Name="EditCourseNameEntry" Placeholder="Course Title" BackgroundColor="White" />
                        <Entry x:Name="EditCourseCodeEntry" Placeholder="Course Code (e.g., COP4710)" BackgroundColor="White" />
                        <Editor x:Name="EditCourseDescEntry" Placeholder="Course Description" HeightRequest="70" BackgroundColor="White" />

                        <Button Text="Save Course Information" 
                                BackgroundColor="#2563EB" 
                                TextColor="White" 
                                FontAttributes="Bold" 
                                CornerRadius="6" 
                                HeightRequest="40" 
                                Clicked="OnSaveCourseInfoClicked" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>

            <!--navigation tabs -->
            <Grid ColumnDefinitions=" *, *, *, *, * " ColumnSpacing="10">
                <Button x:Name="BtnRoster" Grid.Column="0" Text="Roster" BackgroundColor="#0F172A" TextColor="White" CornerRadius="8" Clicked="OnRosterTabClicked" />
                <Button x:Name="BtnAssignments" Grid.Column="1" Text="Assignments" BackgroundColor="#475569" TextColor="White" CornerRadius="8" Clicked="OnAssignmentsTabClicked" />
                <Button x:Name="BtnModules" Grid.Column="2" Text="Modules" BackgroundColor="#475569" TextColor="White" CornerRadius="8" Clicked="OnModulesTabClicked" />
                <Button x:Name="BtnAnnouncements" Grid.Column="3" Text="Announcements" BackgroundColor="#475569" TextColor="White" CornerRadius="8" HeightRequest="42" Clicked="OnAnnouncementsTabClicked" />
                <Button x:Name="BtnGradebook" Grid.Column="4" Text="Gradebook" Clicked="OnGradebookTabClicked" BackgroundColor="#475569" TextColor="White" CornerRadius="8" HeightRequest="40" />
            </Grid>

            <!--Section 1: Roster Management -->
            <VerticalStackLayout x:Name="RosterSection" Spacing="15" IsVisible="True">
                <Label Text="Course Roster Management" FontSize="18" FontAttributes="Bold" TextColor="#1E293B" />
    

                <!-- Current Roster List -->
                <!--import and export Buttons -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                    <Button Grid.Column="0" 
                            Text="Import Roster (CSV)" 
                            BackgroundColor="#059669" 
                            TextColor="White" 
                            FontAttributes="Bold"
                            CornerRadius="8" 
                            HeightRequest="40" 
                            Clicked="OnImportRosterClicked" />

                    <Button Grid.Column="1" 
                            Text="Export Roster (CSV)" 
                            BackgroundColor="#2563EB" 
                            TextColor="White" 
                            FontAttributes="Bold"
                            CornerRadius="8" 
                            HeightRequest="40" 
                            Clicked="OnExportRosterClicked" />
                </Grid>
                <!--Search bar for students in roster-->
                <SearchBar TextChanged="OnRosterSearchTextChanged" x:Name="RosterSearchBar"/>

                <!-- Currently Enrolled Students List -->
                <Label Text="Currently Enrolled Students:" FontSize="14" FontAttributes="Bold" TextColor="#475569" />
                
                <CollectionView x:Name="RosterCollectionView" SelectionMode="None" HeightRequest="300">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeShape="RoundRectangle 8" Padding="12" Margin="0,0,0,8" BackgroundColor="White" Stroke="#E2E8F0">
                                <Grid ColumnDefinitions="*, Auto">
                                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" />
                                        <Label Text="{Binding Id, StringFormat='Student ID: {0}'}" FontSize="12" TextColor="#64748B" />
                                    </VerticalStackLayout>
                                    
                                    <Button Grid.Column="1" 
                                            Text="Remove" 
                                            BackgroundColor="#EF4444" 
                                            TextColor="White" 
                                            CornerRadius="6" 
                                            HeightRequest="36"
                                            Clicked="OnRemoveStudentClicked" 
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Enroll Student Section 
                Binding ID on enroll student to differentiate if duplicate (Barry allen example)-->
                <Border StrokeShape="RoundRectangle 10" Padding="15" BackgroundColor="#F1F5F9" Stroke="#CBD5E1">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Enroll a Student:" FontSize="14" FontAttributes="Bold" TextColor="#334155" />
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                            <Picker x:Name="AvailableStudentsPicker" 
                                    Grid.Column="0" 
                                    Title="Select student..." 
                                    ItemDisplayBinding="{Binding DisplayNameWithId}"
                                    BackgroundColor="White" />
                            
                            <Button Grid.Column="1" 
                                    Text="Enroll Student" 
                                    BackgroundColor="#16A34A" 
                                    TextColor="White" 
                                    CornerRadius="6" 
                                    Clicked="OnEnrollStudentClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!--Section 2: Assignments management -->
            <VerticalStackLayout x:Name="AssignmentsSection" Spacing="15" IsVisible="False">
                <Label Text="Course Assignments Management" FontSize="18" FontAttributes="Bold" TextColor="#1E293B" />

                <!--Import/export buttons for assignments using same dessign as roster buttons-->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                    <Button Grid.Column="0" 
                            Text="Import Assignment (CSV)" 
                            BackgroundColor="#059669" 
                            TextColor="White" 
                            FontAttributes="Bold"
                            CornerRadius="8" 
                            HeightRequest="40" 
                            Clicked="OnImportAssignmentClicked" />

                    <Button Grid.Column="1" 
                            Text="Export Assignment (CSV)" 
                            BackgroundColor="#2563EB" 
                            TextColor="White" 
                            FontAttributes="Bold"
                            CornerRadius="8" 
                            HeightRequest="40" 
                            Clicked="OnExportAssignmentClicked" />
                </Grid>

                <!-- Create / Edit Assignment or Quiz Form -->
                <Border StrokeShape="RoundRectangle 10" Padding="15" BackgroundColor="White" Stroke="#E2E8F0">
                    <VerticalStackLayout Spacing="12">
                        <Label x:Name="AssignmentFormHeader" Text="Add New Item" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" />

                        <!--Item Type Selection Buttons -->
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                            <Button x:Name="BtnSelectStandard" Grid.Column="0" Text="Standard Assignment" Clicked="OnSelectStandardTypeClicked" BackgroundColor="#2563EB" TextColor="White" CornerRadius="6" />
                            <Button x:Name="BtnSelectQuiz" Grid.Column="1" Text="Quiz" Clicked="OnSelectQuizTypeClicked" BackgroundColor="#E2E8F0" TextColor="#334155" CornerRadius="6" />
                        </Grid>

                        <!-- Title Entry -->
                        <Entry x:Name="AssignmentNameEntry" Placeholder="Title / Name (e.g., Midterm Quiz)" />

                        <!-- regular Assignment Description (Visible for normal assg) -->
                        <Editor x:Name="AssignmentDescriptionEntry" Placeholder="Description / Instructions..." HeightRequest="80" IsVisible="True" />

                        <!-- quiz question (Visible for quiz) -->
                        <Editor x:Name="QuizQuestionEditor" Placeholder="Enter the Quiz Question for students to answer..." HeightRequest="90" BackgroundColor="#EFF6FF" IsVisible="False" />

                        <!-- points and due date -->
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                            <Entry x:Name="TotalPointsEntry" Grid.Column="0" Placeholder="Total Points" Keyboard="Numeric" />
                            <DatePicker x:Name="DueDateEntry" Grid.Column="1" Format="d" MinimumDate="2026-01-01" />
                        </Grid>

                        <!--form action buttons -->
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,5,0,0">
                            <Button x:Name="SaveAssignmentBtn" Grid.Column="0" Text="Save Item" BackgroundColor="#16A34A" TextColor="White" CornerRadius="6" Clicked="OnSaveAssignmentClicked" />
                            <Button x:Name="CancelAssignmentEditBtn" Grid.Column="1" Text="Cancel" BackgroundColor="#64748B" TextColor="White" CornerRadius="6" IsVisible="True" Clicked="OnCancelAssignmentEditClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- existing assignment list -->
                <Label Text="Current Course Assignments:" FontSize="14" FontAttributes="Bold" TextColor="#475569" Margin="0,10,0,0" />
                
                <CollectionView x:Name="AssignmentsCollectionView" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeShape="RoundRectangle 8" Padding="12" Margin="0,0,0,8" BackgroundColor="White" Stroke="#CBD5E1">
                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" />
                                        <Label Text="{Binding Description}" FontSize="13" TextColor="#475569" MaxLines="2" LineBreakMode="TailTruncation" />
                                        <HorizontalStackLayout Spacing="12" Margin="0,4,0,0">
                                            <Label Text="{Binding TotalPoints, StringFormat='Points: {0}'}" FontSize="12" TextColor="#2563EB" FontAttributes="Bold" />
                                            <Label Text="{Binding DueDate, StringFormat='Due: {0:MM/dd/yyyy}'}" FontSize="12" TextColor="#DC2626" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                        <Button Text="Submissions" 
                                                BackgroundColor="#059669" 
                                                TextColor="White" 
                                                CornerRadius="6" 
                                                HeightRequest="36" 
                                                Clicked="OnViewSubmissionsClicked" 
                                                CommandParameter="{Binding .}" />
                                        <Button Text="Copy" 
                                                BackgroundColor="#7C3AED" 
                                                TextColor="White" 
                                                CornerRadius="6" 
                                                HeightRequest="36" 
                                                Clicked="OnCopyAssignmentClicked" 
                                                CommandParameter="{Binding .}" />
                                        <Button Text="Edit" 
                                                BackgroundColor="#2563EB" 
                                                TextColor="White" 
                                                CornerRadius="6" 
                                                HeightRequest="36" 
                                                Clicked="OnEditAssignmentClicked" 
                                                CommandParameter="{Binding .}" />
                                        <Button Text="Delete" 
                                                BackgroundColor="#EF4444" 
                                                TextColor="White" 
                                                CornerRadius="6" 
                                                HeightRequest="36" 
                                                Clicked="OnDeleteAssignmentClicked" 
                                                CommandParameter="{Binding .}" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!--Section 3: Module Management-->
            <VerticalStackLayout x:Name="ModulesSection" Spacing="15" IsVisible="False">
                <Label Text="Course Module Management" FontSize="18" FontAttributes="Bold" TextColor="#1E293B" />

                <!-- Create / Edit Module Form -->
                <Border StrokeShape="RoundRectangle 10" Padding="15" BackgroundColor="White" Stroke="#E2E8F0">
                    <VerticalStackLayout Spacing="12">
                        <Label x:Name="ModuleFormHeader" Text="Add New Module" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" />

                        <Entry x:Name="ModuleNameEntry" Placeholder="Module Name (e.g. Unit 1: Introduction to Data Structures)" />
                        <Editor x:Name="ModuleDescriptionEntry" Placeholder="Module Description / Overview..." HeightRequest="70" />

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,5,0,0">
                            <Button x:Name="SaveModuleBtn" Grid.Column="0" Text="Save Module" BackgroundColor="#16A34A" TextColor="White" CornerRadius="6" Clicked="OnSaveModuleClicked" />
                            <Button x:Name="CancelModuleEditBtn" Grid.Column="1" Text="Cancel" BackgroundColor="#64748B" TextColor="White" CornerRadius="6" IsVisible="False" Clicked="OnCancelModuleEditClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!--existing modules list -->
                <Label Text="Course Modules:" FontSize="14" FontAttributes="Bold" TextColor="#475569" Margin="0,10,0,0" />

                <CollectionView x:Name="ModulesCollectionView" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeShape="RoundRectangle 8" Padding="15" Margin="0,0,0,12" BackgroundColor="White" Stroke="#CBD5E1">
                                <VerticalStackLayout Spacing="10">

                                    <!-- module header and options -->
                                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" />
                                            <Label Text="{Binding Description}" FontSize="13" TextColor="#475569" />
                                        </VerticalStackLayout>

                                        <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                            <Button Text="+ Content" BackgroundColor="#059669" TextColor="White" CornerRadius="6" HeightRequest="34" Clicked="OnAddContentClicked" CommandParameter="{Binding .}" />
                                            <Button Text="Edit" BackgroundColor="#2563EB" TextColor="White" CornerRadius="6" HeightRequest="34" Clicked="OnEditModuleClicked" CommandParameter="{Binding .}" />
                                            <Button Text="Delete" BackgroundColor="#EF4444" TextColor="White" CornerRadius="6" HeightRequest="34" Clicked="OnDeleteModuleClicked" CommandParameter="{Binding .}" />
                                        </HorizontalStackLayout>
                                    </Grid>

                                    <!--Module content item list-->
                                    <Border BackgroundColor="#F8FAFC" Padding="10" StrokeShape="RoundRectangle 6" Stroke="#E2E8F0">
                                        <VerticalStackLayout Spacing="8">
                                            <Label Text="Module Contents / Readings:" FontSize="12" FontAttributes="Bold" TextColor="#64748B" />

                                            <CollectionView ItemsSource="{Binding Content}" SelectionMode="None">
                                                <CollectionView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnDefinitions="*, Auto" Margin="0,2,0,2">
                                                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                                <Label Text="{Binding Name}" FontSize="13" FontAttributes="Bold" TextColor="#1E293B" />
                                                                <!--Page Body Display (PageItem.Body) -->
                                                                <Label Text="{Binding Body, StringFormat='📄 Body: {0}'}" 
                                                                    FontSize="12" 
                                                                    TextColor="#334155" 
                                                                    MaxLines="3" 
                                                                    LineBreakMode="TailTruncation" />

                                                                <!-- FilePath Display (FilePath)-->
                                                                <Label Text="{Binding FilePath, StringFormat='📁 Path: {0}'}" 
                                                                    FontSize="12" 
                                                                    TextColor="#2563EB" 
                                                                    MaxLines="1" 
                                                                    LineBreakMode="MiddleTruncation" />
                                                            </VerticalStackLayout>

                                                            <!--Content control options-->
                                                            <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                                                <Button Text="View" BackgroundColor="#0F172A" TextColor="White" CornerRadius="4" HeightRequest="30" FontSize="11" Clicked="OnViewContentItemClicked" CommandParameter="{Binding .}" />
                                                                <Button Text="Edit" BackgroundColor="#3B82F6" TextColor="White" CornerRadius="4" HeightRequest="30" FontSize="11" Clicked="OnEditContentItemClicked" CommandParameter="{Binding .}" />
                                                                <Button Text="Delete" BackgroundColor="#EF4444" TextColor="White" CornerRadius="4" HeightRequest="30" FontSize="11" Clicked="OnDeleteContentItemClicked" CommandParameter="{Binding .}" />
                                                            </HorizontalStackLayout>
                                                        </Grid>
                                                    </DataTemplate>
                                                </CollectionView.ItemTemplate>
                                            </CollectionView>
                                        </VerticalStackLayout>
                                    </Border>

                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!--Section 4: Announcements -->
            <VerticalStackLayout x:Name="AnnouncementsSection" Spacing="15" IsVisible="False">
                
                <Label Text="Course Announcements" 
                    FontSize="18" 
                    FontAttributes="Bold" 
                    TextColor="#1E293B" />

                <!--Post new announcement form -->
                <Border StrokeShape="RoundRectangle 10" 
                        Padding="15" 
                        BackgroundColor="#F8FAFC" 
                        Stroke="#CBD5E1">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="📢 Post New Announcement" 
                            FontSize="16" 
                            FontAttributes="Bold" 
                            TextColor="#0F172A" />
                        
                        <Entry x:Name="AnnouncementTitleEntry" 
                            Placeholder="Announcement Title" 
                            BackgroundColor="White" />

                        <Editor x:Name="AnnouncementContentEntry" 
                                Placeholder="Write announcement details here..." 
                                HeightRequest="90" 
                                BackgroundColor="White" />

                        <Button Text="Post Announcement" 
                                BackgroundColor="#2563EB" 
                                TextColor="White" 
                                FontAttributes="Bold"
                                CornerRadius="8" 
                                HeightRequest="42"
                                Clicked="OnPostAnnouncementClicked" />
                    </VerticalStackLayout>
                </Border>

                <!--Posted announcements list -->
                <Label Text="Posted Announcements:" 
                    FontSize="14" 
                    FontAttributes="Bold" 
                    TextColor="#475569" 
                    Margin="0,5,0,0" />

                <CollectionView x:Name="AnnouncementsCollectionView" SelectionMode="None" HeightRequest="300">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeShape="RoundRectangle 8" 
                                    Padding="15" 
                                    Margin="0,0,0,10" 
                                    BackgroundColor="White" 
                                    Stroke="#E2E8F0">
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Grid.Column="0" 
                                            Text="{Binding Title}" 
                                            FontSize="16" 
                                            FontAttributes="Bold" 
                                            TextColor="#0F172A" />
                                        
                                        <Label Grid.Column="1" 
                                            Text="{Binding DatePosted, StringFormat='{0:MMM dd, yyyy h:mm tt}'}" 
                                            FontSize="12" 
                                            TextColor="#64748B" />
                                    </Grid>
                                    
                                    <Label Text="{Binding Content}" 
                                        FontSize="14" 
                                        TextColor="#334155" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
            <!--Section 5: GRADEBOOK-->
            <VerticalStackLayout x:Name="GradebookSection" Spacing="15" IsVisible="False">
                
                <Grid ColumnDefinitions="*, Auto">
                    <Label Grid.Column="0" Text="Course Gradebook" FontSize="20" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center" />
                    
                    <!-- Export Gradebook Button -->
                    <Button Grid.Column="4" 
                            Text="Export Gradebook (CSV)" 
                            BackgroundColor="#059669" 
                            TextColor="White" 
                            FontAttributes="Bold" 
                            CornerRadius="8" 
                            HeightRequest="40" 
                            Clicked="OnExportGradebookClicked" />
                </Grid>

                <Border BackgroundColor="White" Stroke="#CBD5E1" StrokeShape="RoundRectangle 8" Padding="10">
                    <ScrollView Orientation="Both" HeightRequest="400">
                        <!-- Dynamic Grid in TCDP.xaml.cs-->
                        <Grid x:Name="GradebookGrid" RowSpacing="8" ColumnSpacing="15" Padding="5" />
                    </ScrollView>
                </Border>

            </VerticalStackLayout>

            <!-- Go Back Button -->
            <Button Text="⬅️ Back to Teacher Dashboard" 
                    BackgroundColor="#64748B" 
                    TextColor="White" 
                    CornerRadius="8" 
                    HeightRequest="45" 
                    Margin="0,15,0,0" 
                    Clicked="OnBackClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>