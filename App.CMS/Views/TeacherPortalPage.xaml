<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="App.CMS.Views.TeacherPortalPage"
             Title="Instructor Portal"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="25" VerticalOptions="Center">

            <Label Text="👨‍🏫 Teacher Dashboard" 
                   FontSize="26" 
                   FontAttributes="Bold" 
                   TextColor="#0F172A" 
                   HorizontalOptions="Center" />

            <Label Text="Welcome to the Teacher Management Portal."
                   FontSize="16"
                   TextColor="#64748B"
                   HorizontalOptions="Center"
                   Margin="0,0,0,30" />

            <!--Teacher Actions -->
            <!--List of courses to manage, then send to manage course page with extended actions-->

            <CollectionView x:Name="TeacherCoursesCollectionView" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 10" Padding="15" Margin="0,0,0,12" BackgroundColor="White">
                            <Grid ColumnDefinitions="*, Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" TextColor="#1E293B" />
                                    <Label Text="{Binding Code, StringFormat='Course Code: {0}'}" FontSize="14" TextColor="#64748B" />
                                </VerticalStackLayout>
                                
                                <Button Grid.Column="1" 
                                        Text="Manage Course" 
                                        BackgroundColor="#0F172A" 
                                        TextColor="White" 
                                        CornerRadius="8" 
                                        Clicked="OnManageCourseClicked" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!--return to main menu button-->
            <Button Text="⬅️  Return to Main Menu"
                    FontSize="16"
                    FontAttributes="Bold"
                    BackgroundColor="#475569"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="50"
                    Margin="0,30,0,0"
                    Clicked="OnReturnToMainMenuClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>