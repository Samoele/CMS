<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="App.CMS.Views.AssignmentSubmissionsPage"
             Title="Assignment Submissions"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20">

            <!-- Assignment Header -->
            <Border StrokeShape="RoundRectangle 10" Padding="15" BackgroundColor="White" Stroke="#E2E8F0">
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="AssignmentTitleLabel" FontSize="20" FontAttributes="Bold" TextColor="#0F172A" />
                    <Label x:Name="AssignmentMetaLabel" FontSize="14" TextColor="#64748B" />
                </VerticalStackLayout>
            </Border>

            <!-- Submission List -->
            <Label Text="Student Submissions:" FontSize="16" FontAttributes="Bold" TextColor="#1E293B" />

            <CollectionView x:Name="SubmissionsCollectionView" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 8" Padding="15" Margin="0,0,0,10" BackgroundColor="White" Stroke="#CBD5E1">
                            <VerticalStackLayout Spacing="8">
                                
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Grid.Column="0" Text="{Binding StudentName}" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" />
                                    <Label Grid.Column="1" Text="{Binding GradeText}" FontSize="14" FontAttributes="Bold" TextColor="#2563EB" />
                                </Grid>

                                <!-- Content submitted by student -->
                                <Border BackgroundColor="#F1F5F9" Padding="10" StrokeShape="RoundRectangle 6" Stroke="Transparent">
                                    <Label Text="{Binding Content}" FontSize="13" TextColor="#334155" />
                                </Border>

                                <!-- file link (Only visible if student uploaded a file) -->
                                <HorizontalStackLayout Spacing="6" IsVisible="{Binding HasFile}" Margin="0,2,0,2">
                                    <Label Text="Attached File:" FontSize="13" FontAttributes="Bold" TextColor="#0284C7" VerticalOptions="Center" />
                                    
                                    <Button Text="{Binding FileName, StringFormat='📄 {0}'}"
                                            Clicked="OnOpenAttachedFileClicked"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="Transparent"
                                            TextColor="#0284C7"
                                            FontAttributes="Bold"
                                            FontSize="13"
                                            Padding="0"
                                            HeightRequest="30"
                                            VerticalOptions="Center" />
                                </HorizontalStackLayout>

                                <!-- Existing teacher feedback if already graded -->
                                <Label Text="{Binding Comment, StringFormat='Comment: {0}'}" 
                                       FontSize="12" 
                                       FontAttributes="Italic" 
                                       TextColor="#475569" 
                                       IsVisible="{Binding HasComment}" />

                                <!-- Grade Button -->
                                <Button Text="Grade Submission" 
                                        BackgroundColor="#0F172A" 
                                        TextColor="White" 
                                        CornerRadius="6" 
                                        HeightRequest="36" 
                                        Margin="0,4,0,0" 
                                        Clicked="OnGradeSubmissionClicked" 
                                        CommandParameter="{Binding .}" />

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="⬅️ Back to Course Detail" BackgroundColor="#64748B" TextColor="White" CornerRadius="8" HeightRequest="45" Clicked="OnBackClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>