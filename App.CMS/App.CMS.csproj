<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- SINGLE TARGET FOR FAST WINDOWS DEV BUILD TIMES -->
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>

    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- App Metadata -->
    <ApplicationTitle>Course Management System</ApplicationTitle>
    <ApplicationId>com.cms.app</ApplicationId>

    <!-- Fast Unpackaged Execution -->
    <WindowsPackageType>None</WindowsPackageType>

    <!-- Fix for referencing CLI executable -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CLI.CMS\CLI.CMS.csproj" />
  </ItemGroup>

</Project>